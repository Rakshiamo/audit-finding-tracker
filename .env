# Database Configuration
DB_NAME=auditdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend / Frontend / AI Service Ports
BACKEND_PORT=8081
FRONTEND_PORT=80
AI_SERVICE_PORT=5000

# Application Configuration
APP_TIMEZONE=Asia/Kolkata

# JWT Configuration
# Ensure this is at least 32 characters for HS256 compatibility
JWT_SECRET=your-super-secret-jwt-key-change-in-production-at-least-32-chars

# AI Service Configuration
GROQ_API_KEY=gsk_your_actual_key_obtained_on_day_1

# Scheduler Configuration (Your Day 7 Responsibility)
SCHEDULER_OVERDUE_CRON=0 0 9 * * *
SCHEDULER_ADVANCE_ALERT_CRON=0 0 10 * * *
SCHEDULER_WEEKLY_SUMMARY_CRON=0 0 11 * * MON
